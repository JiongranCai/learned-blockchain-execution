{
  "schema_version": "experiment-matrix-v8",
  "run_class": "smoke",
  "workload": {
    "synthetic": {
      "seed": 42,
      "initial_keys": 128,
      "key_space": 64,
      "block_count": 2,
      "transactions_per_block": 64,
      "mix": [
        {
          "weight": 1,
          "template": "rmw",
          "read_keys": 1,
          "update_keys": 1,
          "access": {
            "kind": "hotspot",
            "hot_keys": 2,
            "hot_probability": 0.9
          },
          "compute": {
            "min_units": 16,
            "max_units": 16,
            "prefix_fraction": 0
          }
        },
        {
          "weight": 1,
          "template": "rmw",
          "read_keys": 4,
          "update_keys": 2,
          "access": {
            "kind": "uniform"
          },
          "compute": {
            "min_units": 256,
            "max_units": 256,
            "prefix_fraction": 0.5
          }
        },
        {
          "weight": 1,
          "template": "selective_read_set",
          "candidate_keys": 4,
          "compute": {
            "min_units": 128,
            "max_units": 128,
            "prefix_fraction": 0.5
          }
        }
      ]
    }
  },
  "statistical_protocol": "configs/statistical/protocol-v1.json",
  "warmup_rounds": 1,
  "measurement_rounds": 3,
  "order_seed": 20260802,
  "timeout": "2m",
  "environment": {
    "affinity": "uncontrolled_smoke",
    "numa_policy": "uncontrolled_smoke",
    "state_reset": "fresh_state_from_frozen_artifact",
