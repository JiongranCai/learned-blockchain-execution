      "dependency_representation": "version_only",
      "dependency_representation_builder": "none",
      "dependency_wait_policy": "none",
      "dependency_estimate_injection": "disabled",
      "dependency_dispatch": "index_order",
      "estimate_read_policy": "abort_and_reschedule",
      "idle_wait_policy": "park",
      "trace_mode": "counters"
    },
    {
      "id": "direct-ready",
      "engine": "blockstm",
      "policy": "blockstm_preset",
      "executors": 8,
      "max_speculative_inflight": 0,
      "dependency_mode": "mvcc_runtime",
      "dependency_source": "static_program",
      "dependency_representation": "raw_last_writer",
      "dependency_representation_builder": "indexed_by_key",
      "dependency_wait_policy": "direct_predecessor_wait",
      "dependency_estimate_injection": "disabled",
